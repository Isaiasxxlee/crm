DATABASE_URL="postgresql://zuarts:zuarts@localhost:5433/zuarts_conecta?schema=public"
PORT=3001
# Better Auth. Generate the secret with: openssl rand -base64 32 (minimum 32 chars).
BETTER_AUTH_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"
BETTER_AUTH_URL="http://localhost:3001"
ADMIN_EMAIL="admin@zuarts.local"
ADMIN_PASSWORD="cambiar-por-una-senha-local-forte"
ADMIN_NAME="Administrador Zuarts"
# Meta webhook (Instagram). Optional: without these values the webhook answers 503 and the rest of the system works normally.
# META_VERIFY_TOKEN: any random string. Paste the same value in Meta App Dashboard > Webhooks > Verify token.
META_VERIFY_TOKEN=""
# META_APP_SECRET: Meta App Dashboard > App settings > Basic > App secret. Validates the X-Hub-Signature-256 header.
META_APP_SECRET=""
# INSTAGRAM_APP_SECRET: optional. Instagram product > API setup with Instagram login > Instagram app secret. Accepted as a second signing secret.
INSTAGRAM_APP_SECRET=""
